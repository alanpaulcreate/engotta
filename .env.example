# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Comma-separated list of Telegram User IDs allowed to perform admin actions
ADMIN_IDS=123456789,987654321

# SQLite Database Location
DATABASE_PATH=data/database.db

# System Timezone for localizing bus arrival calculations
TIMEZONE=Asia/Kolkata

# Optional: Path to banner image (can be a local path like assets/banner.png or a URL)
# BANNER_PATH=https://example.com/banner.jpg
